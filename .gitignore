# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# keep example files so forkers have a template to copy
!.env.local.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli local state (project ref, pooler url) — never commit
supabase/.temp/

# brand master artwork — large binary, lives in Drive not git
brand/MindaOptima-logo.ai

# skrip ujian sementara — jangan commit
_scratch/

# Worktree sesi serentak hidup SEBELAH repo, bukan dalam ia:
#   ~/Projects/ptmo-crm-<nama>, bukan ./.worktrees/<nama>
# Sengaja tiada entri .worktrees/ di sini. Worktree bersarang ialah salinan
# projek penuh di dalam repo, dan eslint serta tsc melangkahinya — 15 error
# lint dan 145 error TypeScript yang tiada satu pun dari src/, yang memaksa
# setiap gate release dijalankan atas arkib bersih. Mengabaikannya hanya
# menyembunyikan kesan itu; tanpa entri ini, worktree bersarang yang
# tersilap cipta akan muncul dalam `git status` dan dapat diperbaiki.

# Supabase CLI local state. `db start` writes .branches/ and .temp/ into
# the repo; neither belongs in version control.
supabase/.branches/
supabase/.temp/

# Local scratch trees that are not part of this project
project-command-board/
tools/command-board/
